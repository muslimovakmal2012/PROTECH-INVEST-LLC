<style>
:root{
  --bg:#E8EEF0;--ink:#10303B;--muted:#4A6671;--line:#C3D0D5;--panel:#F6F9FA;--fill:#F0BE2B;
  --wool:#F0BE2B;--cold:#3A8FD6;--weld:#FF7A3D;--steel:#8A99A1;--foil:#C9D3D7;--bore:#FFE3D2;--boreC:#CFE6F8;
  color-scheme:light;box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){--bg:#0F2229;--ink:#E6EEF0;--muted:#9DB3BB;--line:#25414B;--panel:#163039;--fill:#7A5F0E;--bore:#3A2418;--boreC:#17384F;color-scheme:dark}
}
:root[data-theme="dark"]{--bg:#0F2229;--ink:#E6EEF0;--muted:#9DB3BB;--line:#25414B;--panel:#163039;--fill:#7A5F0E;--bore:#3A2418;--boreC:#17384F;color-scheme:dark}
*{box-sizing:border-box}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--ink);font:400 17px/1.55 Onest,system-ui,"Segoe UI",Arial,sans-serif;overflow-x:hidden}
a{color:inherit}
:focus-visible{outline:3px solid var(--cold);outline-offset:3px}
.wrap{max-width:1120px;margin:0 auto;padding:0 22px}
h1,h2,.brand,.big-phone{font-family:"Russo One",Impact,"Arial Black",sans-serif;font-weight:400}
header{display:flex;align-items:center;justify-content:space-between;padding:18px 0}
.brand{font-size:20px;text-decoration:none}.brand span{color:var(--muted)}
.call{background:var(--ink);color:var(--bg);text-decoration:none;font-weight:600;padding:10px 18px;border-radius:999px;white-space:nowrap}
.btns{display:flex;gap:12px;flex-wrap:wrap}
.btn{display:inline-block;text-decoration:none;font-weight:600;padding:13px 22px;border-radius:999px;border:2px solid var(--ink)}
.btn.solid{background:var(--ink);color:var(--bg)}

/* hero */
.hero{padding:30px 0 0}
h1{font-size:clamp(44px,11vw,124px);line-height:1;margin:0 0 22px}
.ln{display:block;overflow:hidden;padding-bottom:.06em}
.ln>span{display:block;transform:translateY(108%);animation:up .9s cubic-bezier(.2,.8,.2,1) both}
.ln:nth-child(1)>span{animation-delay:.1s}.ln:nth-child(2)>span{animation-delay:.25s}.ln:nth-child(3)>span{animation-delay:.4s}
@keyframes up{to{transform:none}}
.lead{max-width:30em;color:var(--muted);margin:0 0 24px;font-size:19px;opacity:0;animation:fade .8s ease .9s forwards}
.hero .btns{opacity:0;animation:fade .8s ease 1.1s forwards}
@keyframes fade{to{opacity:1}}
.scene{margin-top:10px}
.scene svg{display:block;width:100%;height:auto}
.hl{animation:jl 1.1s cubic-bezier(.3,.9,.2,1) .5s both}.hr{animation:jr 1.1s cubic-bezier(.3,.9,.2,1) .5s both}
@keyframes jl{from{transform:translateX(-90px)}}@keyframes jr{from{transform:translateX(90px)}}
.bd{opacity:0;animation:heat 5s ease-out 1.55s both}
@keyframes heat{0%{opacity:0;fill:#fff}8%{opacity:1;fill:#FFF1C9}35%{fill:#FF7A3D}100%{opacity:1;fill:#6E3419}}
.fl{opacity:0;transform-box:view-box;transform-origin:500px 110px;animation:flash 1.1s ease-out 1.55s both}
@keyframes flash{0%{opacity:0;transform:scale(.2)}25%{opacity:1;transform:scale(1)}100%{opacity:0;transform:scale(1.35)}}
.sp{stroke:var(--weld);stroke-width:3;stroke-linecap:round;opacity:0;transform-box:view-box;transform-origin:500px 110px;animation:spark .8s ease-out 1.55s both}
@keyframes spark{0%{opacity:1;transform:rotate(var(--a)) translateX(4px)}100%{opacity:0;transform:rotate(var(--a)) translateX(120px)}}

/* story */
.story{height:560vh;background:var(--panel);border-top:2px solid var(--ink);margin-top:34px}
.stage{position:sticky;top:0;height:100vh;height:100svh;display:flex;align-items:center}
.st{display:grid;grid-template-columns:.85fr 1.15fr;gap:16px;align-items:center;width:100%}
.pills{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:22px}
.pill{font:600 13px/1 Onest,sans-serif;padding:9px 12px;border:2px solid var(--line);border-radius:999px;color:var(--ink);cursor:pointer;
  background:linear-gradient(90deg,var(--fill) calc(var(--f,0)*100%),transparent 0)}
.pill.on{border-color:var(--ink)}
.steps{display:grid}
.steps article{grid-area:1/1;opacity:0;transform:translateY(16px);transition:opacity .4s,transform .4s;pointer-events:none}
.steps article.on{opacity:1;transform:none;pointer-events:auto}
.steps h2{font-size:clamp(28px,3.8vw,46px);line-height:1.08;margin:0 0 14px}
.steps p{margin:0 0 16px;max-width:26em;color:var(--muted)}
.modes{display:flex;gap:10px;margin:0 0 14px}
.mode{font:600 15px/1 Onest,sans-serif;border:2px solid var(--ink);background:transparent;color:var(--ink);padding:11px 16px;border-radius:999px;cursor:pointer}
.mode[aria-pressed="true"]{background:var(--ink);color:var(--bg)}
.sv{width:100%;height:auto;max-height:86svh}
.sv .d{stroke-dasharray:1;stroke-dashoffset:1;fill:none}
.sv .ink{stroke:var(--ink);stroke-width:2}
.sv .sc{stroke:var(--muted);stroke-width:3}
.sv .ins{stroke:url(#wool)}.sv[data-mode="cold"] .ins{stroke:url(#foam)}
.sv #bore{fill:var(--bore);opacity:0;transition:fill .3s}.sv[data-mode="cold"] #bore{fill:var(--boreC)}
.sv .lab{opacity:0}.sv .lab text{font:600 20px Onest,sans-serif;fill:var(--ink)}.sv .lab path{stroke:var(--ink);stroke-width:1.6;fill:none}.sv .lab circle{fill:var(--ink)}
.sv .spk{stroke:var(--weld);stroke-width:3;stroke-linecap:round}

/* services */
.services{padding:70px 0 60px}
h2.t{font-size:clamp(28px,4vw,46px);line-height:1.1;margin:0 0 28px}
.rows{display:grid;grid-template-columns:1fr 1fr;gap:0 48px;margin:0;padding:0;list-style:none;align-items:start}
.rows li{position:relative}
.rows li::before{content:"";position:absolute;top:0;left:0;right:0;height:2px;background:var(--ink);transform:scaleX(0);transform-origin:left;transition:transform .8s cubic-bezier(.2,.8,.2,1)}
.rows li.in::before{transform:none}
.row{display:grid;grid-template-columns:44px 1fr 24px;gap:16px;align-items:center;width:100%;padding:22px 0;background:none;border:0;color:var(--ink);text-align:left;font:inherit;cursor:pointer}
.sw{width:44px;height:44px;border-radius:50% 50% 50% 8px;border:2px solid var(--ink);transform:scale(0);transition:transform .6s cubic-bezier(.3,1.6,.5,1) .15s}
li.in .sw{transform:none}
.row b{display:block;font-size:20px;font-weight:600}.row small{color:var(--muted);font-size:15px}
.plus{position:relative;width:20px;height:20px}
.plus::before,.plus::after{content:"";position:absolute;background:var(--ink);left:0;top:9px;width:20px;height:2px;transition:transform .3s}
.plus::after{transform:rotate(90deg)}.row[aria-expanded="true"] .plus::after{transform:none}
.more{display:grid;grid-template-rows:0fr;transition:grid-template-rows .35s ease}
.more>div{overflow:hidden}.more p{margin:0 0 22px 60px;color:var(--muted);font-size:16px}
.row[aria-expanded="true"]+.more{grid-template-rows:1fr}

/* contact */
.contact{background:var(--weld);color:#10303B;padding:64px 0}
.contact h2{font-size:clamp(28px,4vw,46px);line-height:1.1;margin:0 0 18px}
.big-phone{display:inline-block;font-size:clamp(30px,7.2vw,76px);line-height:1.05;text-decoration:none;border-bottom:4px solid #10303B;margin-bottom:22px}
.contact p{margin:0 0 20px;max-width:32em;font-size:18px}
.contact .btn{border-color:#10303B;color:#10303B}.contact .btn.solid{background:#10303B;color:#fff}
.contact :focus-visible{outline-color:#10303B}
footer{padding:26px 0;color:var(--muted);font-size:14px}

@media (max-width:820px){
  .st{grid-template-columns:1fr;gap:8px}
  .sv{order:-1;max-height:44svh}
  .pills{margin-bottom:14px}.pill{font-size:12px;padding:7px 10px}
  .steps p{margin-bottom:12px}
  .rows{grid-template-columns:1fr}
}
@media (prefers-reduced-motion:reduce){
  .ln>span{transform:none;animation:none}.lead,.hero .btns{opacity:1;animation:none}
  .hl,.hr{animation:none}.fl,.sp{display:none}.bd{animation:none;opacity:1;fill:#6E3419}
}
</style>
